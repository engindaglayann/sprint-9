              "});",
              "",
              "pm.test(\"2. Status değeri 'ok' olmalı\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"ok\");",
              "});",
              "",
              "pm.test(\"3. Öğrenci numarası doğru olmalı\", function () {",
              "    var jsonData = pm.response.json();",
