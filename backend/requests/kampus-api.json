    {
      "name": "GET 2 Etkinlik listesi",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"4. Status kodu 200 olmalı\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"5. Dizi olarak etkinlikler dönmeli\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"6. Etkinlikte _id ve createdAt bulunmalı\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0]).to.have.property(\"_id\");",
              "    pm.expect(jsonData[0]).to.have.property(\"createdAt\");",
              "});",
              "",
              "// 3. istekte kullanılmak üzere ilk etkinliğin id'sini değişkene kaydet",
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.length > 0) {",
              "    var id = jsonData[0]._id || jsonData[0].id;",
              "    pm.collectionVariables.set(\"eventId\", id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
