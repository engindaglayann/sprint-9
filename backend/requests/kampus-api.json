      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"7. Status kodu 200 olmalı\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"8. İstenen etkinliğin _id değeri eşleşmeli\", function () {",
              "    var jsonData = pm.response.json();",
              "    var expectedId = pm.collectionVariables.get(\"eventId\");",
              "    if (expectedId) {",
              "        pm.expect(jsonData._id).to.eql(expectedId);",
              "    } else {",
              "        pm.expect(jsonData).to.have.property(\"_id\");",
              "    }",
              "});",
              "",
              "pm.test(\"9. Etkinlik başlık ve kategori içermeli\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"title\");",
              "    pm.expect(jsonData).to.have.property(\"category\");",
              "});"
            ]
          }
        }
